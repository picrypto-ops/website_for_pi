{
  "plugins": [
    "stylelint-selector-bem-pattern"
  ],
  "rules": {
    "selector-class-pattern": null,
    "plugin/selector-bem-pattern": {
      "preset": "bem",
      "componentName": "^[a-z]+(?:-[a-z]+)*$",
      "componentSelectors": {
        "initial": "^\\.{componentName}(?:__[a-z]+(?:-[a-z]+)*)?(?:--[a-z]+(?:-[a-z]+)*)?$"
      },
      "utilitySelectors": "^\\.u-[a-zA-Z0-9\\-]+$",
      "ignoreSelectors": [
        "^\\.no-js$",
        "^\\.js$",
        "^\\.is-[a-z]+$"
      ]
    }
  }
}
