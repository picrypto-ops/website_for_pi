{
  "plugins": [
    "stylelint-selector-bem-pattern"
  ],
  "rules": {
    "selector-class-pattern": null,
    "plugin/selector-bem-pattern": {
      "preset": "bem",
      "componentName": "^[a-z]+$",
      "componentSelectors": {
        "initial": "^\\.{componentName}$|^\\.{componentName}__[a-z]+$|^\\.{componentName}--[a-z]+$|^\\.{componentName}__[a-z]+--[a-z]+$"
      },
      "ignoreSelectors": [
        "^\\.no-js$",
        "^\\.js$",
        "^\\.is-[a-z]+$"
      ]
    }
  }
}
