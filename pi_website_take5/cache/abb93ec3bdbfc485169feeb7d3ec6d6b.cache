                            <a href="?page=about&lang=en">
                                About Us                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=contact&lang=en">
                                Contact Us                            </a>
                        </li>
                                            </ul>
                </nav>
                
                <!-- Section 3: Language Switcher -->
                <div class="language-switcher">
                                        <a href="?page=team-member&id=buky-katzman&lang=en" class="lang-switch active" data-lang="en">EN</a>
                    <span class="separator">|</span>
                    <a href="?page=team-member&id=buky-katzman&lang=he" class="lang-switch " data-lang="he">עב</a>
                </div>
            </div>
