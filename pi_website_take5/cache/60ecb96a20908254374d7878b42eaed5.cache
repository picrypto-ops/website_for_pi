<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Home - Team-member</title>
    <meta name="description" content="Financial Management Professionals">
    <link rel="canonical" href="https://www.pigroup.com/en/team-member">
    <meta property="og:title" content="Home - Team-member">
    <meta property="og:description" content="Financial Management Professionals">
    <meta property="og:url" content="https://www.pigroup.com/en/team-member">
