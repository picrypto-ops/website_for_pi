            font-size: 1.8rem;
            color: #1a3a5f;
            margin-bottom: 25px;
            padding-bottom: 12px;
            font-weight: 600;
        }
        
        .our-team-preview .section-title::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            width: 60px;
            background: linear-gradient(90deg, #0056b3, #007bff);
        }
        
        .our-team-preview .section-description {
            font-size: 1.1rem;
            line-height: 1.6;
            color: #4a4a4a;
            margin-bottom: 30px;
            max-width: 800px;
        }
        
        .team-navigation {
            margin-bottom: 2rem;
        }
        
        .team-nav {
            display: flex;
            list-style: none;
            padding: 0;
            gap: 15px;
            flex-wrap: wrap;
        }
        
        .team-nav li a {
            display: inline-block;
            padding: 8px 15px;
            background-color: #f8fafc;
            border-radius: 4px;
            text-decoration: none;
            color: #1a3a5f;
            transition: all 0.3s ease;
            font-weight: 500;
            border: 1px solid #e2e8f0;
        }
        
        .team-nav li a:hover, 
        .team-nav li a.active {
            background-color: #0056b3;
            color: white;
            border-color: #0056b3;
        }
        
        .view-all-container {
            margin-top: 40px;
            text-align: center;
        }
        
        .view-all-button {
            display: inline-block;
            padding: 12px 24px;
            background-color: #0056b3;
            color: white;
            text-decoration: none;
            border-radius: 4px;
            font-weight: 500;
            transition: all 0.3s ease;
            border: none;
        }
        
        .view-all-button:hover {
            background-color: #003d80;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
    </style>
            <section id="about-us" class="about-preview full-page-section">
        <div class="container">
            <h2>About Us</h2>
            <p><p>Founded in 1999 by Aron Cohen and Jonny Kaye, the PI Group has spent over two decades identifying and capitalizing on high-value opportunities across various sectors and asset classes in Israel and globally.</p> <p>Starting with proprietary derivative trading, where PI quickly became one of Israel's largest firms, we pioneered several financial innovations in the Israeli market. These include issuing Israel's first ETF (the Hadas) in 2003, launching the country's first listed structured product (the Shacharit) in 2005, and establishing Israel's first hedge fund (Arbitrade) in 2004.</p> <p>Our growth continued with the creation of PI EMF, a global macro derivatives fund with 16 years of consistent positive returns, and more recently with strategic partnerships like PI Crypto (2021) and PI PItuach (2023), which has already issued over 7.5 billion ILS in bonds.</p><br><p>As we continue to evolve, PI Group remains committed to identifying market inefficiencies and creating innovative financial solutions. Our experienced team and proven track record position us uniquely in the financial landscape.</p></p>
            <a href="?page=about&lang=en" class="button">
                Read More            </a>
        </div>
        
