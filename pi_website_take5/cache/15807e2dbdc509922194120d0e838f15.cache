    <main id="main-content">


<section class="contact-hero">
    <div class="container">
        <h1>Contact PI Group</h1>
        <p class="slogan">Get in Touch</p>
        <p class="lead">Reach out to us for any inquiries or to learn more about our services.</p>
    </div>
</section>

<section class="contact-us">
    <div class="container">
                
        <div class="contact-content">
            <!-- Form on the left for desktop, last for mobile -->
            <div class="contact-form contact-column">
                <h2>Send Us a Message</h2>
                <form id="contact-form" action="../utility/process-contact.php" method="POST">
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="subject">Subject</label>
                        <input type="text" id="subject" name="subject" required>
                    </div>
                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" required></textarea>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="button button--outline">Send</button>
                    </div>
                </form>
            </div>
            
            <!-- Map and contact info on the right for desktop, first for mobile -->
            <div class="contact-info-map contact-column">
                <!-- Map section -->
                <div class="map-section">
                    <h2>Map</h2>
                    <div id="map" 
                         class="contact-map"
                         data-lat="32.109608"
                         data-lng="34.837384"
                         data-address="18, Raoul Wallenberg, Tel Aviv, Israel">
                    </div>
                    <p class="map-link">
                        <a href="https://www.openstreetmap.org/?mlat=32.109608&mlon=34.837384#map=21/32.109608/34.837384" target="_blank">
                            View Larger Map                        </a>
                    </p>
                </div>
                
                <!-- Contact information -->
                <div class="contact-info">
                    <h2>Contact Information</h2>
                    
                    <div class="contact-info-grid">
                        <!-- Address card -->
                        <div class="contact-card address">
                            <div class="icon"><i class="fa fa-map-marker-alt"></i></div>
                            <div class="contact-info">
                                <h3>Address</h3>
                                <p>18, Raoul Wallenberg, Tel Aviv, Israel</p>
                                                                    <p>Zipcode: 6971001</p>
                                                            </div>
                        </div>
                        
                        <!-- Phone card -->
                        <div class="contact-card phone">
                            <div class="icon"><i class="fa fa-phone"></i></div>
                            <div class="contact-info">
                                <h3>Phone</h3>
                                <p>
                                    Tel:
                                    <a href="tel:+97233732090">+972-3-3732090</a>
                                </p>
                                                                    <p>Fax: +972-3-3732102</p>
                                                            </div>
                        </div>
                        
                        <!-- Email card -->
                        <div class="contact-card email">
                            <div class="icon"><i class="fa fa-envelope"></i></div>
                            <div class="contact-info">
                                <h3>Email</h3>
                                <p><a href="mailto:info@pi-hf.com">info@pi-hf.com</a></p>
                            </div>
                        </div>
                        
                        <!-- Website card -->
                                                <div class="contact-card website">
                            <div class="icon"><i class="fa fa-globe"></i></div>
                            <div class="contact-info">
                                <h3>Website</h3>
                                <p><a href="https://www.pi-hf.com" target="_blank">https://www.pi-hf.com</a></p>
                            </div>
                        </div>
                                            </div>
                </div>
            </div>
        </div>
    </div>
</section>

