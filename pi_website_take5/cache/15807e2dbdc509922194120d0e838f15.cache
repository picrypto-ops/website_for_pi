<section class="contact-hero">
    <div class="container">
        <h1>Contact PI Group</h1>
        <p class="slogan">Get in Touch</p>
        <p class="lead">Reach out to us for any inquiries or to learn more about our services.</p>
    </div>
</section>

<section class="contact-us">
    <div class="container">
        <div class="contact-content">
            <!-- Form on the left for desktop, last for mobile -->
            <div class="contact-form contact-column">
                <h2>Send Us a Message</h2>
                <form id="contact-form" action="process-contact.php" method="POST">
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="subject">Subject</label>
                        <input type="text" id="subject" name="subject" required>
                    </div>
                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" required></textarea>
                    </div>
                    <button type="submit" class="button">Send</button>
                </form>
            </div>
            
            <!-- Map and contact info on the right for desktop, first for mobile -->
            <div class="contact-info-map contact-column">
                <!-- Map section -->
                <div class="map-section">
                    <h2>Map</h2>
                    <div id="map" class="contact-map"></div>
                    <p class="map-link">
                        <a href="https://www.openstreetmap.org/?mlat=32.109608&mlon=34.837384#map=21/32.109608/34.837384" target="_blank">
                            View Larger Map                        </a>
                    </p>
                </div>
                
                <!-- Contact information -->
                <div class="contact-info">
                    <h2>Contact Information</h2>
                    
                    <div class="contact-info-grid">
                        <!-- Address card -->
                        <div class="contact-card address">
                            <div class="icon"><i class="fa fa-map-marker-alt"></i></div>
                            <div class="contact-info-content">
                                <h3>Address</h3>
                                <p>18, Raoul Wallenberg, Tel Aviv, Israel</p>
                                                                    <p>Zipcode: 6971001</p>
                                                            </div>
                        </div>
                        
                        <!-- Phone card -->
                        <div class="contact-card phone">
                            <div class="icon"><i class="fa fa-phone"></i></div>
                            <div class="contact-info-content">
                                <h3>Phone</h3>
                                <p><a href="tel:+97233732090">+972-3-3732090</a></p>
                                                                    <p>Fax: +972-3-3732102</p>
                                                            </div>
                        </div>
                        
                        <!-- Email card -->
                        <div class="contact-card email">
                            <div class="icon"><i class="fa fa-envelope"></i></div>
                            <div class="contact-info-content">
                                <h3>Email</h3>
                                <p><a href="mailto:info@pi-hf.com">info@pi-hf.com</a></p>
                            </div>
                        </div>
                        
                        <!-- Website card -->
                                                <div class="contact-card website">
                            <div class="icon"><i class="fa fa-globe"></i></div>
                            <div class="contact-info-content">
                                <h3>Website</h3>
                                <p><a href="https://www.pi-hf.com" target="_blank">https://www.pi-hf.com</a></p>
                            </div>
                        </div>
                                            </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Include Leaflet CSS and JS for OpenStreetMap -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
      crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" 
        crossorigin=""></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize the map
    const map = L.map('map').setView([32.109608, 34.837384], 17);
    
    // Add OpenStreetMap tile layer
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19
    }).addTo(map);
    
    // Add a marker for the office location
    const officeLocation = [32.109608, 34.837384];
    const marker = L.marker(officeLocation).addTo(map);
    
    // Add a popup with the address
    marker.bindPopup('18, Raoul Wallenberg, Tel Aviv, Israel').openPopup();
    
    // Ensure the map container is visible and redraws properly
    setTimeout(function() {
        map.invalidateSize();
    }, 100);
});
</script>

