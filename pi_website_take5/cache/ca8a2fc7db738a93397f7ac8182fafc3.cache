<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Segment</title>
    <meta name="description" content="Financial Management Professionals">
    <link rel="canonical" href="https://www.pigroup.com/en/segment">
    <meta property="og:title" content="Home - Segment">
    <meta property="og:description" content="Financial Management Professionals">
    <meta property="og:url" content="https://www.pigroup.com/en/segment">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://www.pigroup.com/assets/images/og-image.jpg">
    <link rel="stylesheet" href="assets/css/main.css">
    <script type="module" src="assets/js/main.js"></script>
    <script src="assets/js/menu.js" defer></script>
    <script src="assets/js/language-switcher.js" defer></script>
    </head>
<body class="segment-page">
    <header id="site-header" class="">
        <div class="container">
            <div class="header-content">
                <!-- Mobile menu toggle button for screens < 768px -->
                <button class="mobile-menu-toggle" 
                    aria-label="Toggle navigation menu" 
                    aria-expanded="false">
                    <span class="menu-icon">
                        <span class="bar"></span>
                        <span class="bar"></span>
                        <span class="bar"></span>
                    </span>
                </button>
                
                <!-- Section 1: Logo & Group name -->
                <div class="logo-section">
                    <a href="?page=home&lang=en" class="logo-link">
                        <div class="logo-container">
                            <img src="assets/images/logo_small.svg" alt="PI Group Logo">
                            <span class="group-name">PI Group</span>
                        </div>
                    </a>
                </div>
                
                <!-- Section 2: Main Navigation Menu -->
                <nav class="main-nav">
                    <ul>
                                                <li class="">
                            <a href="?page=home&lang=en">
                                Home                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=segment&id=investment_banking&lang=en">
                                Investment Banking                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=segment&id=asset_management&lang=en">
                                Asset Management                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=our-team&lang=en">
                                Our Team                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=about&lang=en">
                                About Us                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=contact&lang=en">
                                Contact Us                            </a>
                        </li>
                                            </ul>
                </nav>
                
                <!-- Section 3: Language Switcher -->
                <div class="language-switcher">
                                        <a href="?page=segment&id=asset_management&lang=en" class="lang-switch active" data-lang="en">EN</a>
                    <span class="separator">|</span>
                    <a href="?page=segment&id=asset_management&lang=he" class="lang-switch " data-lang="he">עב</a>
                </div>
            </div>
        </div>
    </header>
    <main id="main-content">


<section class="segment">
    <div class="container">
        <h1>Asset Management</h1>
        <div class="segment-description">
            Our asset management services have been built on a foundation of excellence since 2004, with a diverse range of hedge funds under our management. We strive to deliver consistent, positive returns, and to date, none of our funds have experienced a losing year. Pi has always maintained a significant investment in the funds we manage for our partners.        </div>

        <h3>Our Products</h3>
        <div class="product-grid">
                                                <a href="?page=product&id=pi_emf&lang=en" class="product-card">
                        <div class="product-content">
                            <div class="product-icon">
                                                                    <img src="assets/images/asset_management/pi_emf_retired/logo_large.svg" alt="PI EMF (retired)">
                                                            </div>
                            <div class="product-text">
                                <h3>PI EMF (retired)</h3>
                            </div>
                        </div>
                        <p class="slogan">
                            Mastering Market Discrepancies                        </p>
                    </a>
                                    <a href="?page=product&id=pi_global&lang=en" class="product-card">
                        <div class="product-content">
                            <div class="product-icon">
                                                                    <img src="assets/images/asset_management/pi_global/logo_large.svg" alt="PI Global">
                                                            </div>
                            <div class="product-text">
                                <h3>PI Global</h3>
                            </div>
                        </div>
                        <p class="slogan">
                            Macro & Derivatives Excellence                        </p>
                    </a>
                                    <a href="?page=product&id=pi_equity&lang=en" class="product-card">
                        <div class="product-content">
                            <div class="product-icon">
                                                                    <img src="assets/images/asset_management/pi_equity/logo_large.svg" alt="PI Equity">
                                                            </div>
                            <div class="product-text">
                                <h3>PI Equity</h3>
                            </div>
                        </div>
                        <p class="slogan">
                            Cultivating Israeli Business Gems                        </p>
                    </a>
                                    </div>
    </div>
</section>

</main>
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <img src="assets/images/logo.svg" alt="PI Group Logo">
                    <p class="footer-text">PI Group Financial Services</p>
                </div>
                <div class="footer-links">
                    <ul>
                                            </ul>
                </div>
                <div class="footer-social">
                    <!-- Add social media links here -->
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 PI Group. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>

