<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Home - Segment</title>
    <meta name="description" content="Financial Management Professionals">
    <link rel="canonical" href="https://www.pigroup.com/en/segment">
    <meta property="og:title" content="Home - Segment">
    <meta property="og:description" content="Financial Management Professionals">
    <meta property="og:url" content="https://www.pigroup.com/en/segment">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://www.pigroup.com/assets/images/og-image.jpg">
    <link rel="stylesheet" href="assets/css/main.css">
    <script type="module" src="assets/js/main.js"></script>
    <script src="assets/js/menu.js" defer></script>
    <script src="assets/js/language-switcher.js" defer></script>
    </head>
<body class="segment-page">
    <header id="site-header" class="">
        <div class="container">
            <div class="header-content">
                <!-- Mobile menu toggle button for screens < 768px -->
                <button class="mobile-menu-toggle" 
                    aria-label="Toggle navigation menu" 
                    aria-expanded="false">
                    <span class="menu-icon">
                        <span class="bar"></span>
                        <span class="bar"></span>
                        <span class="bar"></span>
                    </span>
                </button>
                
                <!-- Section 1: Logo & Group name -->
                <div class="logo-section">
                    <a href="?page=home&lang=en" class="logo-link">
                        <div class="logo-container">
                            <img src="assets/images/logo_small.svg" alt="PI Group Logo">
                            <span class="group-name">PI Group</span>
                        </div>
                    </a>
                </div>
                
                <!-- Section 2: Main Navigation Menu -->
                <nav class="main-nav">
                    <ul>
                                                <li class="">
                            <a href="?page=home&lang=en">
                                Home                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=segment&id=investment_banking&lang=en">
                                Investment Banking                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=segment&id=asset_management&lang=en">
                                Asset Management                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=our-team&lang=en">
                                Our Team                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=about&lang=en">
                                About Us                            </a>
                        </li>
                                                <li class="">
                            <a href="?page=contact&lang=en">
                                Contact Us                            </a>
                        </li>
                                            </ul>
                </nav>
                
                <!-- Section 3: Language Switcher -->
                <div class="language-switcher"><a href="?page=segment&id=investment_banking&lang=en" class="lang-switch active" data-lang="en">EN</a><span class="separator">|</span><a href="?page=segment&id=investment_banking&lang=he" class="lang-switch " data-lang="he">עב</a></div>            </div>
        </div>
    </header>
    <main id="main-content">


<section class="segment">
    <div class="container">
        <h1>Investment Banking</h1>
        <div class="segment-description">
            Our investment banking services are tailored to advise and support exceptional financial innovators and dynamic growing firms. We help visionaries turn their ideas into reality while strategically assisting established companies in raising capital, executing mergers, and acquiring businesses to fuel their growth. In the past, we have invested alongside our partners in every deal we have structured.        </div>

        <h3>Our Products</h3>
        <div class="product-grid">
                                                <a href="?page=product&id=pi_pituach&lang=en" class="product-card">
                        <div class="product-content">
                            <div class="product-icon">
                                                                    <img src="assets/images/investment_banking/pi_pituach/logo_large.svg" alt="PI Pituach">
                                                            </div>
                            <div class="product-text">
                                <h3>PI Pituach</h3>
                            </div>
                        </div>
                        <p class="slogan">
                            Innovate Today, Secure Tomorrow                        </p>
                    </a>
                                    <a href="?page=product&id=pi_select&lang=en" class="product-card">
                        <div class="product-content">
                            <div class="product-icon">
                                                                    <img src="assets/images/investment_banking/pi_select/logo_large.svg" alt="PI Select">
                                                            </div>
                            <div class="product-text">
                                <h3>PI Select</h3>
                            </div>
                        </div>
                        <p class="slogan">
                            Invest With Confidence                        </p>
                    </a>
                                    </div>
    </div>
</section>

</main>
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                                    </div>
                <div class="footer-links">
                    <ul>
                                            </ul>
                </div>
                <div class="footer-social">
                    <!-- Add social media links here -->
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 PI Group. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>

